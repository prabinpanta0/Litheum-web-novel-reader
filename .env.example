# Litheum environment (Vite reads VITE_* at build time)

# Base URL of the deployed Neon sync function.
# Defaults to the production deployment in src/sync/client.ts.
# Override here if needed for local dev (e.g. http://localhost:8787).
#VITE_SYNC_API=

# Neon Function env (set these in the Neon project, not committed):
# DATABASE_URL=postgresql://...
# AUTH_SECRET=...
